# Copy to .env locally. Never commit real values.
# Production should load the same names from Azure Key Vault, not from a file.
# See docs/integrated-services.md for service ownership, data handling, and sprint timing.
#
# Sprint 1 needs none of the cloud credentials below.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Opt-in only. CI must leave this unset. Opens real audio devices in desktop-app tests.
RUN_LIVE_AUDIO=0

# -----------------------------------------------------------------------------
# Desktop → backend transport (Sprint 3)
# Streams mixed PCM while the session is running; Pause cuts the stream.
# BACKEND_AUTH_MODE is mtls or token. Fill only the variables for the chosen mode.
# -----------------------------------------------------------------------------
BACKEND_BASE_URL=
BACKEND_AUTH_MODE=mtls
BACKEND_AUTH_TOKEN=

TLS_CA_CERT_PATH=
TLS_CLIENT_CERT_PATH=
TLS_CLIENT_KEY_PATH=

# -----------------------------------------------------------------------------
# Trigger phrase (Sprint 2). Detected in the session transcript, not via Picovoice.
# Exact wording is still an open Legal/product item.
# -----------------------------------------------------------------------------
TRIGGER_PHRASE=
STREAM_BUFFER_SECONDS=8

# -----------------------------------------------------------------------------
# Backend process / TLS terminator (Sprint 3+)
# -----------------------------------------------------------------------------
BACKEND_BIND_HOST=127.0.0.1
BACKEND_BIND_PORT=8443
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CLIENT_CA_PATH=

# -----------------------------------------------------------------------------
# Azure Speech continuous STT (Sprint 3) and streaming TTS (Sprint 5)
# Same Speech resource for both. STT runs for the unpaused session, not clip-only.
# -----------------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_TTS_VOICE=en-US-JennyNeural
# Names Azure should expect, comma-separated. The trigger phrase is added automatically.
AZURE_SPEECH_PHRASES=Hemas,Hemas Holdings

# -----------------------------------------------------------------------------
# Anthropic Claude Agent SDK
# Orchestrator: Sprint 4. External intelligence agent: Sprint 12 (separate instance).
# Both agents default to claude-opus-5-5 when the model is left empty.
# Keep the key on one line; a wrapped value is read as a truncated key.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_ORCHESTRATION_MODEL=
ANTHROPIC_EXTERNAL_MODEL=

# -----------------------------------------------------------------------------
# Databricks — shared workspace host
# Genie read token and Unity Catalog write token must be different credentials.
# -----------------------------------------------------------------------------
DATABRICKS_HOST=

# Genie Conversation API (Phase 2, Sprints 9–10). Read-only at the code level.
DATABRICKS_GENIE_TOKEN=
DATABRICKS_GENIE_SPACE_ID=
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog board-tier write path (Sprint 6). Never include a raw audio field.
DATABRICKS_STORAGE_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_INTERACTIONS_TABLE=

# -----------------------------------------------------------------------------
# Local governed storage (Sprint 6, development and test only)
# Stores board transcripts, questions and answers as JSON files; never audio.
# Leave empty to store nothing. Must be an absolute path. Refused unless
# ENVIRONMENT is development or test; the folder is locked to the current user.
# Unity Catalog (below) replaces this in production.
# -----------------------------------------------------------------------------
LOCAL_STORAGE_DIR=

# -----------------------------------------------------------------------------
# Azure Key Vault (production secrets manager)
# Prefer managed identity in Azure; service principal vars are for local/CI test envs only.
# -----------------------------------------------------------------------------
AZURE_KEY_VAULT_URI=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# External intelligence agent: opt-in web search (Phase 3)
# Trusted domains only; the API enforces the list and the search cap.
# Reuters, AP, BBC, Economist, FT and WSJ block Anthropic's crawler: the API
# rejects the whole request if any listed domain is blocked, so leave them out.
# -----------------------------------------------------------------------------
EXTERNAL_SEARCH_ENABLED=false
EXTERNAL_SEARCH_ALLOWED_DOMAINS=bloomberg.com,cnbc.com,cse.lk,cbsl.gov.lk,economynext.com,ft.lk,dailymirror.lk,sundaytimes.lk,newsfirst.lk,imf.org,worldbank.org
EXTERNAL_SEARCH_MAX_USES=5

# -----------------------------------------------------------------------------
# Standing news / press feed (Phase 3, Sprint 11)
# Vendor is not chosen yet. Do not add an SDK until vendor-risk analysis covers it.
# -----------------------------------------------------------------------------
NEWS_API_KEY=
NEWS_API_BASE_URL=
